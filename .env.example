# ================================================================================
# KanhaERP Configuration
# ================================================================================
# Copy this file to .env and update values for your deployment
# NEVER commit .env to version control
# ================================================================================

# APPLICATION CORE
APP_NAME=KanhaERP
APP_VERSION=1.0.0
DEMO_MODE=true
IS_PRODUCTION=false

# SECURITY (CRITICAL - Change these before production)
SECRET_KEY=your-super-secret-key-change-this-to-random-long-string
ADMIN_PASSWORD=admin123
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,*

# COMPANY INFO
COMPANY_NAME=Your Company Pvt Ltd
COMPANY_CODE=YOUR
COMPANY_GSTIN=22AAAAA0000A1Z5
ADMIN_EMAIL=admin@yourcompany.com

# BRANDING
BRAND_TAGLINE=Your Company Tagline
BRAND_PRIMARY=#1d4ed8
BRAND_ACCENT=#0f766e
BRAND_LOGO_URL=/assets/favicon.svg
BRAND_SUPPORT_EMAIL=support@yourcompany.com

# DATABASE (Default: SQLite for development)
# SQLite (development):
DATABASE_URL=sqlite:///./data/kanha_erp.db

# PostgreSQL (production recommended):
# DATABASE_URL=postgresql+psycopg2://kanha:password@localhost:5432/kanha_erp

# REDIS (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# ================================================================================
# INTEGRATIONS (Optional - Leave empty if not using)
# ================================================================================

# WhatsApp Business API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Razorpay Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# E-Invoice / E-Way (GSP)
GSP_BASE_URL=https://api.example.com
GSP_API_KEY=

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourcompany.com

# Maps
MAPS_API_KEY=
MAPS_PROVIDER=google  # google or mapbox

# AI / LLM
LLM_API_KEY=
LLM_PROVIDER=openai  # openai or azure
LLM_MODEL=gpt-4

# ================================================================================
# ADVANCED (Usually don't need to change)
# ================================================================================

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_RUN_CASH=false  # Turn on after WhatsApp is verified

# Cluster (for high availability)
CLUSTER_ENABLED=false
CLUSTER_NODE_ID=primary
CLUSTER_ROLE=primary  # primary or replica
CLUSTER_TOKEN=change-this-token
CLUSTER_PRIMARY_URL=http://127.0.0.1:8000

# Backup Mirrors
BACKUP_MIRROR_PATHS=

# Data
DATA_DIR=./data
UPLOADS_DIR=./data/uploads

# Logging
LOG_LEVEL=INFO

# ================================================================================
# NOTES FOR PRODUCTION
# ================================================================================
# 
# 1. SECURITY:
#    - Change SECRET_KEY to a long random string
#    - Set ADMIN_PASSWORD to strong password
#    - Set CORS_ORIGINS to your domain (never use *)
#    - Enable HTTPS (reverse proxy with nginx/Caddy)
#    - Use DATABASE_URL=postgresql+... (not SQLite)
#
# 2. INTEGRATIONS:
#    - Get keys from each service provider
#    - Test each integration before going live
#    - Never share keys or commit .env
#
# 3. BACKUPS:
#    - Set up daily automated backups
#    - Test restore process regularly
#    - Keep backups on separate disk/cloud
#
# 4. MONITORING:
#    - Set up health checks
#    - Enable logging
#    - Monitor server resources
#
# See GO_LIVE.md for complete production checklist
# ================================================================================
