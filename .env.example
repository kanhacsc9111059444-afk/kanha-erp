# KanhaERP environment — copy to .env before go-live
# copy .env.example .env

# ── White-label product ──────────────────────────────────────────
APP_NAME=KanhaERP
APP_VERSION=1.0.0
BRAND_TAGLINE=Enterprise OS
BRAND_LOGO_URL=/assets/favicon.svg
BRAND_SUPPORT_EMAIL=support@yourcompany.com
BRAND_PRIMARY=#1d4ed8
BRAND_ACCENT=#0f766e

COMPANY_NAME=Your Company Pvt Ltd
COMPANY_CODE=YOURCO
COMPANY_GSTIN=27AABCT1234D1Z5

# ── Security (REQUIRED for production) ───────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
DEMO_MODE=false
ENFORCE_SECURE_SECRET=true
MIN_PASSWORD_LENGTH=8
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=300
CORS_ORIGINS=https://erp.yourcompany.com,http://127.0.0.1:8080
ACCESS_TOKEN_EXPIRE_MINUTES=720

ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeThisStrong1
ADMIN_FULL_NAME=System Admin
# Owner Ultra Support (login page ◉). Strong secret in production.
CORE_OWNER_EMAIL=
CORE_CONTROL_PASS=

# Public live-share gate (HTTP Basic). Leave empty for local-only.
# SHARE_GATE_USER=viewer
# SHARE_GATE_PASSWORD=

# ── Database ─────────────────────────────────────────────────────
# Local demo SQLite (default if unset):
# DATABASE_URL=sqlite:///./data/kanha_erp.db
# Production Postgres:
# DATABASE_URL=postgresql+psycopg2://kanha:STRONG_PASS@localhost:5432/kanha_erp
REDIS_URL=redis://localhost:6379/0

# ── Agent scheduler ──────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_RUN_CASH=false
SCHEDULER_RUN_STOCK=true
SCHEDULER_RUN_COMPLIANCE=true
SCHEDULER_RUN_WHATSAPP=true

# ── WhatsApp Meta Cloud API (LIVE path) ─────────────────────────
# When both set → sends hit Meta Cloud (no wamid.DEMO*). Empty = local demo send.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0
# Meta webhook hub.verify_token (GET /api/meta/whatsapp/webhook)
WHATSAPP_VERIFY_TOKEN=kanha_meta_verify

# ── Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── GSP e-Invoice / e-Way (LIVE path) ────────────────────────────
# When BASE_URL + API_KEY set → IRN/e-Way push to GSP; response IRN/EWB stored.
# Empty = local DEMO-IRN / DEMO-EWB (still usable for training).
GSP_BASE_URL=
GSP_API_KEY=
GSP_API_SECRET=

# ── Maps ─────────────────────────────────────────────────────────
MAPS_PROVIDER=none
MAPS_API_KEY=

# ── LLM (optional) ───────────────────────────────────────────────
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# ── SMTP (optional) ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

UPLOAD_MAX_MB=15

# ── HA / multi-site resilience (portable ERP × 5) ────────────────
# Better design: 1 primary WRITER + hot replicas (identical data) + 5 mirror packs.
# Do NOT run 5 simultaneous writers — that causes split-brain / duplicate data.
CLUSTER_ENABLED=true
CLUSTER_NODE_ID=node-1
CLUSTER_ROLE=primary
CLUSTER_TOKEN=change-me-shared-cluster-secret
CLUSTER_PUBLIC_URL=http://127.0.0.1:8080
CLUSTER_PRIMARY_URL=http://127.0.0.1:8080
# Comma-separated sibling node URLs (replicas / peers)
CLUSTER_PEERS=
CLUSTER_SYNC_SECONDS=30
CLUSTER_HEARTBEAT_SECONDS=10
CLUSTER_FAILOVER_AFTER_SECONDS=45
CLUSTER_PRIORITY=100
CLUSTER_REQUIRE_PROBE=true
CLUSTER_MIN_FAILOVER_PROBES=2

# Up to 5 physical locations for identical portable packs (folders / drives / NAS)
# Empty → auto: data/mirrors/site-1 .. site-5
BACKUP_MIRROR_1=
BACKUP_MIRROR_2=
BACKUP_MIRROR_3=
BACKUP_MIRROR_4=
BACKUP_MIRROR_5=
# Optional extra user-held pack (USB / home NAS)
BACKUP_USER_PACK=
