# Prefer Python 3.11–3.12 for pip wheels.
# On this machine (Python 3.14), run.bat uses kanha-ai-trading-engine .venv.
server {
    listen 80;
    server_name kanhaerp.local;
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
